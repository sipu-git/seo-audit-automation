# Required by the backend API and background worker.
PORT=4000
# Defaults to enabled outside production. Set true to include backend error details and stacks in API responses while debugging.
# DEBUG_API_ERRORS=true
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
PASSWORD_RESET_OTP_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ADMIN_EMAILS="admin@example.com"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
REDIS_URL="rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379"

# AI analysis is required to complete an audit report. Create a Gemini API key in Google AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL_ID="gemini-3.8-flash"

# PageSpeed works without a key at lower quota; an API key is recommended.
PAGESPEED_API_KEY=""

# Optional live data providers. Search Console access token must have read access
# to the configured property. Leave these unset to mark the sources unavailable.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=""
GOOGLE_SEARCH_CONSOLE_PROPERTY=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Cron-job.org calls GET /api/cron/audits with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
CRON_AUDIT_INTERVAL="monthly"
SCHEDULED_AUDIT_TARGETS='[{"url":"https://example.com","businessType":"Dental clinic","city":"Pune","state":"Maharashtra"}]'

# Crawl only public HTTP/S hosts. The crawler caps this at 25 pages per audit.
CRAWL_MAX_PAGES=8

# Choose S3 for durable report storage. Keep the bucket private.
AUDIT_REPORT_STORAGE="local"
# For durable deployed reports, change storage to "s3" and configure:
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET="YOUR_PRIVATE_BUCKET_NAME"
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# Optional: completion webhook; leave empty to disable delivery.
AUDIT_COMPLETED_WEBHOOK_URL=""
