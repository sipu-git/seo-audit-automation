{
  "name": "crawlix-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch index.ts",
    "api": "tsx index.ts",
    "api:watch": "tsx watch index.ts",
    "worker": "tsx src/modules/worker/audit-worker.ts",
    "worker:watch": "tsx watch src/modules/worker/audit-worker.ts",
